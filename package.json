{
  "name": "mira",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "setup": "bun install && cd apps/serve && uv sync --all-groups && cd ../..",
    "check": "turbo run check",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.4",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "type": "module"
}