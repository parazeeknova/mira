{
  "name": "@mira/web",
  "private": true,
  "type": "module",
  "module": "src/server/index.ts",
  "scripts": {
    "build": "mkdir -p dist && bun build --target=bun --production --minify --sourcemap --external sharp --outdir dist ./src/server/index.ts && cp -R src/client/. dist/client/ 2>/dev/null || true",
    "dev": "bun --env-file=../../.env.development --env-file=../../.env --watch src/server/index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env.development --env-file=../../.env dist/index.js",
    "check": "oxlint --fix . && oxfmt --write .",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:blockchain": "bun scripts/test-blockchain.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "bun test && playwright test"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.11",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.2"
  }
}
