PORT=3000
MIRA_SERVE_URL=ws://127.0.0.1:8765

MIRA_R2_BUCKET=mira
MIRA_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MIRA_R2_ACCESS_KEY_ID=
MIRA_R2_SECRET_ACCESS_KEY=

# Blockchain (Phase 2) — local Hardhat node by default (`bun run chain:node`),
# then `bun run chain:deploy` writes FACE_RECORD_CONTRACT_ADDR here.
# AMOY_RPC_URL is only needed if you point the client at a public testnet.
AMOY_RPC_URL=
WALLET_PRIVATE_KEY=
FACE_RECORD_CONTRACT_ADDR=
