# Mira Serve — Python Pipeline (Phase 1)
# Copy to .env and fill required values: cp .env.example .env

# ── Search — Primary: Google Cloud Vision ─────────────────────────
# Vision takes raw image bytes (no hosting). Auth via gcloud ADC:
#   gcloud auth application-default login --project=larity
# or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_VISION_ENABLED=true
GOOGLE_VISION_MAX_RESULTS=8

# ── Search — Secondary: SerpAPI ────────────────────────────────────
# Single key drives BOTH Google Lens + Yandex in parallel (same cost)
# Get a key at https://serpapi.com — free tier = 100 searches/month
# Each pipeline run consumes 2 searches (one per engine)
SERPAPI_KEY=

# ── Search — Tertiary: FaceCheck.id (engine 4) ─────────────────────
# Dedicated face search engine — 1.4B face index, base64 crops in response
# Get token at https://facecheck.id — paid tier, demo=true for local dev (0 credits, ~100k faces)
FACECHECK_API_TOKEN=
FACECHECK_MAX_RESULTS=8
# FACECHECK_DEMO=true            # uncomment for local dev only (0 credits, ~100k face index)

# ── Pipeline ──────────────────────────────────────────────────────
# Master switch — set false to disable pipeline.run WS handler
PIPELINE_ENABLED=true

# Face crop padding as fraction of bbox size (float, default 0.18 / 0.22 in spec)
# Larger padding preserves context for Lens; 1.0 gives ~3x bbox area
FACE_CROP_PADDING_X=1.0
FACE_CROP_PADDING_Y=1.0

# Max seconds to wait for each SerpAPI engine (float, default 12)
SEARCH_TIMEOUT_SECONDS=12

# Max merged results returned after dedupe + ranking (int, default 5, spec default 8 per engine)
SEARCH_MAX_RESULTS=8

# ── Similarity & Cache Thresholds ─────────────────────────────────
# Discard candidates below this cosine similarity (float, default 0.35)
COSINE_THRESHOLD=0.35
# Same-person threshold for SQLite cache lookup (float, default 0.60)
CACHE_THRESHOLD=0.60
# SQLite cache DB path (relative to apps/serve/mira_serve/, or absolute)
CACHE_DB_PATH=../../data/mira_cache.db
